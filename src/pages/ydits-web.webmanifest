{
    "manifest_version": 3,
    "name": "YDITS for Web",
    "short_name": "YDITS-Web",
    "description": "防災情報をすぐに確認できるWebアプリケーション。",
    "version": "3.18.2.0",
    "minimum_chrome_version": "116",
    "scope": "./",
    "start_url": "./index.html",
    "display": "standalone",
    "display_override": [
        "window-controls-overlay",
        "standalone"
    ],
    "icons": [
        {
            "src": "https://cdn.ydits.net/images/ydits_logos/ydits_icon_512px.png",
            "type": "image/png",
            "sizes": "512x512"
        },
        {
            "src": "https://cdn.ydits.net/images/ydits_logos/ydits_icon_192px.png",
            "type": "image/png",
            "sizes": "192x192"
        }
    ],
    "background": {
        "service_worker": "./scripts/ydits-web/sw.js",
        "type": "module"
    }
}